option_settings:

  # 단일 인스턴스로 띄운다. 로드밸런서를 붙이면 ALB 요금이 매달 따로 나가는데
  # (프리티어에 포함되지 않는다) 지금은 APK가 서버 주소에 직접 붙는 구조라 쓸 데가 없다.
  # 나중에 HTTPS가 필요해지면 그때 LoadBalanced로 바꾼다.
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance

  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro
    # 기본 8GB로는 그래들 빌드 캐시와 도커 레이어가 같이 쌓이면 모자란다.
    # 프리티어 EBS가 30GB까지라 12GB는 무료 범위 안이다.
    RootVolumeType: gp3
    RootVolumeSize: "12"

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # 단일 인스턴스에는 로드밸런서가 없어서 지금은 동작하지 않는다.
  # LoadBalanced로 바꾸는 순간 필요해지므로 미리 적어 둔다.
  # 기본값 "/"로 두면 우리 서버가 404를 돌려줘서 계속 비정상으로 잡힌다.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/breathing/presets

  # 비밀이 아닌 값만 여기 둔다.
  # DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET, OPENAI_API_KEY,
  # FIREBASE_CREDENTIALS_BASE64는 콘솔이나 `eb setenv`로 넣는다. (DEPLOY.md 참고)
  #
  # 환경 속성은 전부 합쳐 4,096바이트를 넘을 수 없다. 넘으면 오류 없이 조용히 저장에 실패한다.
  # 아래 다섯 개가 약 104바이트를 쓴다.
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    # EB는 EXPOSE에 적힌 첫 포트로 nginx를 연결한다. Dockerfile이 8080이므로 맞춰 고정한다.
    # 비워 두면 플랫폼이 넣는 값에 따라 앱이 다른 포트에 붙어 헬스체크가 죽을 수 있다.
    PORT: "8080"
    FIREBASE_ENABLED: "true"
    REPORT_PROVIDER: openai
    OPENAI_MODEL: gpt-5.4-mini
